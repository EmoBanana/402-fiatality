# ---------------------------------------------------------------
# 402 Fiatality configuration. Copy to .env and fill in what you have.
# Everything runs offline in "mock" mode with no keys at all.
# ---------------------------------------------------------------

# PayPal: "mock" runs fully offline, "sandbox" uses developer.paypal.com sandbox
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# AI: "mock" runs offline on deterministic rules. For Gemma 4, set LLM_PROVIDER=ollama after
# `ollama pull gemma4:12b` (24 GB Macs) or `ollama pull gemma4:e4b-it-qat` with LLM_MODEL to match (16 GB Macs).
# LLM_PROVIDER: ollama | openai (any OpenAI-compatible endpoint) | mock
LLM_PROVIDER=mock
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=gemma4:12b
LLM_API_KEY=
# Time for one three-role AI spend review before it escalates to a human (ms). Raise it on a slow or
# memory-starved machine: Gemma 4 12B on a busy 16 GB Mac writes about 5-7 tokens a second.
LLM_REVIEW_BUDGET_MS=45000

# Channel3 product data (optional). Empty = built-in demo catalog seller.
CHANNEL3_API_KEY=

# PayPal sandbox emails that receive seller payouts (optional)
SELLER_PAYPAL_EMAIL_CHANNEL3=
SELLER_PAYPAL_EMAIL_PRICEWATCH=
SELLER_PAYPAL_EMAIL_REVIEWS=

# Encrypts seller API keys at rest. Generated into data/ on first run if empty.
MASTER_KEY=

# Where the SQLite database and the generated master key live (relative to the repo root). Empty = data/.
DATA_DIR=

# Ports and URLs. HOST=0.0.0.0 listens on every interface (containers, Render); the demo sellers stay on loopback.
HOST=localhost
PORT=4020
SELLERS_PORT=4030
# The Vite dev server (npm run dev).
WEB_PORT=5173
# Where browsers and PayPal reach the gateway and the web app. Blank = http://localhost:<PORT> and
# http://localhost:<WEB_PORT>; on Render, the service's onrender.com URL (RENDER_EXTERNAL_URL); a blank WEB_BASE_URL
# is PUBLIC_BASE_URL when the gateway serves the built app (npm start).
PUBLIC_BASE_URL=
WEB_BASE_URL=

# Demo helpers: seeds demo sellers and a company, enables the fast-forward clock
DEMO_MODE=1
# Share of flaky responses from the demo reviews seller (0..1)
FLAKY_RATE=0.3
# Required header value for mutating /api calls when DEMO_MODE=0
ADMIN_TOKEN=
# Record each tab charge as a paid PayPal invoice (Invoicing v2: draft, shared as a link, payment recorded;
# MOCK-INV-... in mock mode). Optional and best effort: a failed invoice never fails the charge and is retried.
# PayPal disputes on tab charges need no setting: they sync every 2 minutes in sandbox, and the AI jury hears each one.
PAYPAL_INVOICE_RECORDS=0

# Public demo safety: per-IP limits on the routes that call PayPal, the LLM or start agents (429 past the limit).
# Requests from this machine (127.0.0.1/::1, not forwarded) are exempt. 0 turns a limit off.
RATE_LIMIT_PAYPAL_PER_MINUTE=30
RATE_LIMIT_AI_PER_MINUTE=30
RATE_LIMIT_AGENT_RUNS_PER_10_MINUTES=10
# Reverse proxies in front of the gateway trusted for the client IP (X-Forwarded-For). Blank = 2 on Render (its load
# balancer and Cloudflare), 0 elsewhere.
TRUST_PROXY_HOPS=

# Optional UI license keys (watermarked trials work without them)
VITE_AG_GRID_LICENSE_KEY=
VITE_AG_STUDIO_LICENSE_KEY=
VITE_BRYNTUM_LICENSE_KEY=
